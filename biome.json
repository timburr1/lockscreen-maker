{
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": {
        "useBlockStatements": "error",
        "noNonNullAssertion": "error",
        "useConst": "error"
      },
      "nursery": { "noFloatingPromises": "error" }
    }
  },
  "files": { "includes": ["**", "!dist", "!node_modules", "!**/*.md"] }
}
